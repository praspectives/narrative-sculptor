# Copy this to .env and fill in your key for dev/testing.
# Production (personal Mac with Ollama) does not need this file.

# Choose one provider for --dev-api mode:
DEV_API=grok             # or: anthropic, groq, openai

# Set the matching API key:
GROK_API_KEY=xai-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...

# Optional: override the default model for the chosen provider
# DEV_MODEL=grok-2-latest
# DEV_MODEL=claude-haiku-4-5-20251001
# DEV_MODEL=llama-3.1-8b-instant
# DEV_MODEL=gpt-4o-mini
